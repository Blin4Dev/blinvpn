# Сборка админ-панели BlinVPN
FROM node:22-alpine AS build
WORKDIR /app/panel
COPY src/panel/package.json src/panel/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY src/panel ./
# Логотип берётся из корневого каталога assets/ (общий с мини-аппом и сайтом)
COPY assets /app/assets
RUN npm run build

FROM nginx:alpine
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/panel/dist /usr/share/nginx/html
EXPOSE 80
