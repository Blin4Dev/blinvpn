FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN set -eux; \
    apt-get update; apt-get install -y --no-install-recommends curl unzip ca-certificates; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) f=Xray-linux-64.zip ;; arm64) f=Xray-linux-arm64-v8a.zip ;; *) f="" ;; esac; \
    if [ -n "$f" ]; then \
      curl -fsSL -o /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/latest/download/$f"; \
      curl -fsSL -o /tmp/xray.dgst "https://github.com/XTLS/Xray-core/releases/latest/download/$f.dgst"; \
      want="$(grep -i 'SHA2-256' /tmp/xray.dgst | head -1 | awk '{print $2}')"; \
      echo "$want  /tmp/xray.zip" | sha256sum -c -; \
      unzip -o /tmp/xray.zip xray -d /usr/local/bin; chmod 0755 /usr/local/bin/xray; \
    fi; \
    rm -f /tmp/xray.zip /tmp/xray.dgst; \
    apt-get purge -y curl unzip; apt-get autoremove -y; rm -rf /var/lib/apt/lists/*

COPY docker/requirements.txt /app/requirements.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN for i in 1 2 3; do \
      pip install --no-cache-dir --timeout 60 --retries 10 --index-url "$PIP_INDEX_URL" -r /app/requirements.txt && exit 0; \
      echo "pip install: попытка $i не удалась, повтор через 10 с" >&2; sleep 10; \
    done; exit 1

COPY src /app/src
COPY node.sh /app/node.sh
ENV PYTHONPATH=/app/src/core:/app/src/api \
    DB_PATH=/app/data/data.db

RUN groupadd -g 1000 app 2>/dev/null || true \
    && useradd -u 1000 -g 1000 -m app 2>/dev/null || true \
    && mkdir -p /app/data \
    && chown -R app:app /app
USER app
WORKDIR /app/src/core

CMD ["python", "/app/src/core/monitor.py"]
