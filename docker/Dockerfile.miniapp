# Сборка Telegram mini-app BlinVPN
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY src/app ./src/app
# Страница-переходник для deep-link Incy/Happ (копируется в сборку)
COPY src/site ./src/site
# Картинки живут в корневом каталоге assets/ — нужны сборке для /assets/*
COPY assets ./assets
RUN npm run build:miniapp

FROM nginx:alpine
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/miniapp /usr/share/nginx/html
EXPOSE 80
