{
    "_comment_basic": "═══ БАЗОВЫЕ ═══════════════════════════════════════════════",

    "port": 4100,
    "remnawave_url": "http://127.0.0.1:3000",
    "api_token": "ВАШ_REMNAWAVE_API_TOKEN",
    "sub_path": "/api/sub",
    "log_level": "info",

    "_comment_groups": "═══ ГРУППЫ И ИМЕНА ════════════════════════════════════════",

    "auto_group_name": "🇪🇺 AUTO | Самые быстрые",
    "groups": {
        "🇫🇮 Финляндия": ["Finland"],
        "🇩🇪 Германия": ["German"],
        "🇳🇱 Нидерланды": ["Netherlands"],
        "🇪🇺 Europe LTE": ["LTE"]
    },
    "auto_groups": false,
    "auto_groups_interval_sec": 300,
    "lte_patterns": ["LTE", "Mobile+", "WHITE"],

    "_comment_fastest": "═══ AUTO ГРУППА (самые быстрые) ═══════════════════════════",

    "fastest_group": true,
    "fastest_exclude": [],
    "fastest_fallback": ["🇪🇺 Europe LTE"],

    "_comment_balancer": "═══ БАЛАНСЕР И PROBE (КРИТИЧНО ДЛЯ НАГРУЗКИ) ══════════════",

    "strategy": "leastLoad",
    "probe_url": "https://www.gstatic.com/generate_204",
    "probe_interval": "10m",
    "probe_sampling": 1,
    "probe_timeout": "1s",
    "load_expected": 3,
    "balancer_tolerance": 0.5,
    "balancer_tolerance_fallback": 0.8,

    "_comment_baselines": "═══ BASELINE'Ы для каскада балансеров ═════════════════════",

    "default_tier1_baseline_ms": 1600,
    "default_tier2_baseline_ms": 4000,
    "default_main_with_lte_baseline_ms": 2000,
    "default_single_baseline_ms": 4000,
    "default_lte_baseline_ms": 4000,

    "_comment_sticky": "═══ STICKY-СЕССИИ ══════════════════════════════════════════",

    "sticky_session": false,
    "sticky_threshold_ms": 1000,
    "sticky_ttl_hours": 168,
    "sticky_persist_path": "/app/data/sticky-assignments.json",
    "sticky_exclude_groups": ["🇪🇺 AUTO | Самые быстрые"],
    "sticky_flush_interval_sec": 300,
    "sticky_hard_max_age_days": 30,
    "sticky_max_tokens_in_memory": 100000,
    "sticky_in_memory_cleanup_interval_hours": 5,

    "_comment_tier": "═══ TIER-FAILOVER (per-group) ══════════════════════════════",

    "group_tiers": {
        "🇫🇮 Финляндия": {
            "tier1_count": 3,
            "tier1_baseline_ms": 1500,
            "tier2_baseline_ms": 4000
        }
    },

    "_comment_node_stats": "═══ NODE STATS (фильтр перегруженных нод) ════════════════",

    "node_stats": false,
    "node_stats_interval_sec": 120,
    "max_users_per_gb": 20,
    "max_users_per_cpu": 40,
    "node_stats_exclude": [],
    "node_load_threshold": 1.0,

    "_comment_routing": "═══ ROUTING (Happ profiles) ════════════════════════════════",

    "happ_routing_url": "",
    "happ_routing_update_interval_sec": 3600,
    "udp_block": true,

    "_comment_clients": "═══ КЛИЕНТЫ (тумблеры) ═════════════════════════════════════",

    "mihomo_enabled": true,
    "singbox_enabled": true,
    "mihomo_urltest_tolerance_ms": 50,
    "singbox_urltest_tolerance_ms": 50,

    "_comment_http": "═══ HTTP TIMEOUTS / LIMITS ═════════════════════════════════",

    "http_timeout_ms": 10000,
    "http_max_redirects": 3,
    "max_response_bytes": 10485760,

    "_comment_server": "═══ HTTP SERVER TIMEOUTS ═══════════════════════════════════",

    "server_keepalive_timeout_sec": 65,
    "server_headers_timeout_sec": 66,
    "server_request_timeout_sec": 30,

    "_comment_cache": "═══ КЭШ UPSTREAM ═══════════════════════════════════════════",

    "upstream_cache_ttl_sec": 300,
    "upstream_cache_max_entries": 5000,
    "upstream_cache_cleanup_interval_sec": 600,

    "_comment_rate_limit": "═══ RATE LIMITER ═══════════════════════════════════════════",

    "rate_limit": { "max": 5, "window_sec": 60 },
    "rate_limit_cleanup_interval_sec": 300,

    "_comment_dev": "═══ DEV / DEBUG ════════════════════════════════════════════",

    "dev_raw_tokens": [],
    "mihomo_pro_tokens": []
}
